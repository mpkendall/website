---
interface Props { title: string; body: string; image: string; href?: string }
const { title, body, image, href } = Astro.props;
---
{href ? <a class="project-card" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noreferrer' : undefined}>
	<img class="project-image" src={image} alt="" />
	<div class="card-content">
		<h3>{title}</h3>
		<p>{body}</p>
		<span class="click-hint">Click to open ↗</span>
	</div>
	</a> : <article class="project-card">
	<img class="project-image" src={image} alt="" />
	<div class="card-content"><h3>{title}</h3><p>{body}</p></div>
</article>}
