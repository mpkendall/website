---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DetailCard from '../components/DetailCard.astro';
import Hero from '../components/Hero.astro';

const projects = [
	['Tiny4FSK', 'An ultra-tiny, fully open-source high-altitude research platform for students, educators, and researchers.', 'https://github.com/New-England-Weather-Balloon-Society/Tiny4FSK', '/assets/projects/tiny4fsk.png'],
	['habtronics', 'A business selling high-altitude electronics, services, and curriculum to educators and hobbyists.', 'https://www.habtronics.com', '/assets/projects/habtronics.png'],
	['N.E.W.B.S.', 'The New England Weather Balloon Society, an online and in-person club dedicated to launching, tracking, and recovering balloons.', 'https://nescitech.org/newbs', '/assets/projects/NEWBS.jpg'],
	['Apex', 'A months-long near-space hackathon where teens worldwide create projects for high-altitude balloon missions.', 'https://apex.hackclub.com', '/assets/projects/apex.png'],
	['HABGab 2023', 'A major high-altitude balloon flight with live video, a ham radio repeater, and student experiments.', 'https://github.com/New-England-Weather-Balloon-Society/HABGab-2023', '/assets/projects/habgab.jpg'],
	['STAX', 'A custom azimuth-elevation rotator used to aim a directional antenna at a balloon payload.', undefined, '/assets/projects/stax.jpg'],
	['Ham Club', 'A Hack Club project that gave youth ham radios if they got their license. I helped with curriculum and organization.', 'https://ham.hackclub.com', '/assets/projects/hamclub.webp'],
	['OpenCV Resistor Finder', 'An OpenCV resistor value finder built for Beantown Bash 2023, which my teammate and I won.', 'https://github.com/mpkendall/resistorfinder', '/assets/projects/beantown.webp'],
	['Cubes in Space 2022', 'An electronics payload using Faraday’s Law to test generating energy from sounding-rocket vibrations.', 'https://github.com/mpkendall/CubesinSpace', '/assets/projects/CiS.jpg'],
	['WB1-3', 'A series of early high-altitude balloon flights before the New England Weather Balloon Society.', 'https://github.com/New-England-Weather-Balloon-Society/WB3', '/assets/projects/wbs.jpg'],
];

const presentations = [
	['How to HAB', 'How to launch your very own high-altitude balloon.', 'August 2026'],
	['StratoScience 2026 - Ham Radio and Education to New Heights', 'A discussion of the StratoScience program and student projects.', 'August 2026'],
	['Arduino Workshop', 'A 3-hour walkthrough of creating a morse code Arduino keyer.', 'August 2026'],
	['StratoScience 2025 - Ham Radio and Education to New Heights', 'A discussion of the StratoScience program and student projects.', 'August 2025'],
	['RF PCB Design', 'Key tips and tricks for RF PCB design, including layout considerations and material selection.', 'April 2025, August 2025'],
	['Tiny4FSK - The Future of High-Altitude Tracking Systems', 'Surface-level general information about Tiny4FSK.', 'April 2024, September 2024'],
	['Tiny4FSK - The Cutting-Edge High-Altitude Tracking System', 'A deep dive into Tiny4FSK and how it works.', 'August 2024, November 2024'],
	['Zero to Hero KiCAD', 'A three-hour workshop teaching students how KiCAD works while they create a blinking circuit.', 'August 2024'],
	['StratoScience 2024 - Ham Radio and Education to New Heights', 'A discussion of the StratoScience program and student projects.', 'August 2024, October 2024, May 2025'],
	['NEWSDR Conference', 'A lightning talk and Tiny4FSK research poster.', 'May 2024'],
	['Practical High-Altitude Ballooning', 'Common practices, tips, and instruction for flying high-altitude balloons.', 'March 2024'],
	['Radiosonde Hunting and Reprogramming', 'Methods of radiosonde retrieval and how to reprogram them.', 'August 2023'],
	['Youth Engineering and Ham Radio on High-Altitude Balloons', 'StratoScience, student projects, and HABGab 2023.', 'August 2023'],
	['Weather Education Day', 'A speaking role at Weather Education Day at Gillette Stadium.', 'April 2023'],
	['DIY Electronics and APRS for HAB Payloads', 'How hobbyists can fly research projects at low cost.', 'August 2022'],
	['Cubes in Space', 'An overview of the Cubes in Space 2022 project.', 'August 2022'],
	['Shake, Shake, Power', 'Cubes in Space 2022 and how Faraday’s Law works.', 'Spring 2022'],
];

const classes = [
	['StratoScience Lab', 'An intensive nine-month hands-on engineering design class where students fly experiments on high-altitude balloons.', '2023–2026', 'https://nescitech.org/stratoscience'],
	['Arduino Class', 'A six-week beginner and intermediate Arduino crash course building laser-tag bots and obstacle-avoidance robots.', '2023–2026', 'https://nescitech.org/arduino'],
	['Arduino Coding and Robotics', 'A season-long Arduino class at the Medway Public Library.', '2019–2024'],
	['WiTek Engineering Workshop', 'An open recurring workshop which I have led several times.', '2023–2024'],
	['StratoScience @ BFCCPS', 'A condensed five-week version of StratoScience Lab for school members.', '2023–2024'],
	['STEAM', 'Mentoring and teaching several STEAM classes at the Medway Public Library.', '2023–2024'],
];

const leadership = [
	['N.E.W.B.S.', 'Founder of the New England Weather Balloon Society; I manage its Discord, teach classes, and work local events.', '2023–2026'],
	['New England Sci-Tech', 'A member of the leadership team, official instructor, and informal advisor at a local STEM makerspace.', '2022–2026'],
	['STARS', 'Vice-president, previously president, youth ambassador, and collegiate outreach of the Sci-Tech Amateur Radio Society.', '2023–2024'],
	['NE HamXposition Youth Subcommittee', 'Helping tailor activities at the North East HamXposition for youth attendees.', '2024'],
	['Sci-Tech Hack Club', 'Co-leading a club that organizes classes and workshops around coding.', '2022–2024'],
	['Science Explorers 4H Club', 'President of a club running 4H activities, including STEAM at the Medway Public Library.', '2023–2024'],
];

const achievements = [
	['MHS - High Honors', 'Academic excellence award at MHS.', '2026'],
	['National Latin Exam Gold Medal', 'A gold medal and perfect score on the National Latin Exam thrice.', '2023–2026'],
	['Amateur Extra Amateur Radio License', 'Passed Technician, General, and Amateur Extra license levels at age 10.', '2020–2021'],
	['BFCCPS Medal of Virtue', 'Recognized for all four virtues: Justice, Temperance, Prudence, and Fortitude.', '2024'],
];

const publicity = [
	['Hackaday - Tiny4FSK', 'An article about the Tiny4FSK project.', '2024', 'https://hackaday.com/2024/10/03/a-lightweight-balloon-tracker-for-high-altitude-missions'],
	['Microchip Makes - Tiny4FSK', 'Informational posts about Tiny4FSK.', '2024', 'https://x.com/MicrochipMakes/status/1790853868764397634'],
	['CBS News - Weather Education Day', 'A segment about the New England Weather Balloon Society and radiosonde hunting.', '2024', 'https://www.cbsnews.com/boston/news/wbz-weather-education-day-new-england-revolution-2024/'],
	['The Boston Globe - N.E.W.B.S.', 'Coverage of the New England Weather Balloon Society and high-profile balloon events.', '2023', 'https://www.bostonglobe.com/2023/02/27/metro/facing-scrutiny-like-never-before-new-englands-amateur-balloonists-are-feeling-pressure/'],
	['Medway-Millis Local Paper', 'Coverage of early New England Weather Balloon Society projects.', '2021', 'https://www.millismedwaynews.com/2021/08/02/364393/rising-fifth-grader-launches-second-weather-balloon-max-kendall-is-now-working-on-a-third-with-the-medway-balloon-society'],
	['Wicked Local - Country Gazette', 'Coverage of independent weather balloon projects.', '2021', 'https://www.wickedlocal.com/picture-gallery/country-gazette/2021/03/03/photos-max-kendalls-weather-balloon-project/6897504002/'],
];
---

<Layout title="Max Kendall">
	<main>
		<nav class="navbar" aria-label="Main navigation">
			<a href="#home">home</a>
			<a href="#projects">projects</a>
			<a href="#speaking">public speaking</a>
			<a href="#classes">classes</a>
			<a href="#leadership">leadership</a>
			<a href="#achievements">achievements</a>
			<a href="#publicity">publicity</a>
		</nav>

		<section id="home"><Hero /></section>

		<Section id="projects" title="projects" intro="">
			<div class="project-grid">
				{projects.map(([title, body, href, image]) => <ProjectCard title={title} body={body} href={href} image={image} />)}
			</div>
		</Section>

		<Section id="speaking" title="public speaking" intro="a few presentations I've authored and delivered.">
			<div class="card-grid">{presentations.map(([title, body, date]) => <DetailCard title={title} body={body} date={date} />)}</div>
		</Section>

		<Section id="classes" title="classes" intro="I also like teaching classes and workshops. here are some I've taught or helped with.">
			<div class="card-grid">{classes.map(([title, body, date, href]) => <DetailCard title={title} body={body} date={date} href={href} accent />)}</div>
		</Section>

		<Section id="leadership" title="leadership" intro="">
			<div class="card-grid">{leadership.map(([title, body, date]) => <DetailCard title={title} body={body} date={date} />)}</div>
		</Section>

		<Section id="achievements" title="awards and achievements" intro="">
			<div class="card-grid">{achievements.map(([title, body, date]) => <DetailCard title={title} body={body} date={date} accent />)}</div>
		</Section>

		<Section id="publicity" title="publicity" intro="here are some publications in which I have been mentioned.">
			<div class="card-grid">{publicity.map(([title, body, date, href]) => <DetailCard title={title} body={body} date={date} href={href} />)}</div>
		</Section>
	</main>
</Layout>
