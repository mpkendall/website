---
import '../styles/global.css';
interface Props { title?: string }
const { title = 'Max Kendall' } = Astro.props;
---
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Max Kendall — RF design, embedded systems, and high-altitude balloon projects." />
		<link rel="icon" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<footer>Made with Astro · <a href="https://github.com/mpkendall/website">Open source on GitHub</a> · © 2026 Max Kendall</footer>
	</body>
</html>
